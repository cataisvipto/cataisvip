{
  "name": "catai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npx kill-port 3000 2>/dev/null & next dev -p 3000",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "build:quick": "next build --no-lint",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/validate-schemas.js && node scripts/validate-data.js && node scripts/check-i18n.js && node scripts/check-css-vars.js && node scripts/check-component-behavior.js",
    "test:component": "node scripts/check-component-behavior.js",
    "test:data": "node scripts/validate-data.js",
    "test:i18n": "node scripts/check-i18n.js",
    "test:css": "node scripts/check-css-vars.js",
    "test:schema": "node scripts/validate-schemas.js",
    "docs:sync": "node _internal/update-doc-stats.js",
    "hooks:install": "node _internal/install-hooks.js",
    "audit:freshness": "node scripts/audit-freshness.mjs",
    "audit:verdict": "node scripts/audit-verdict-tokens.mjs",
    "audit:pricing": "node scripts/audit-pricing-drift.mjs",
    "audit:all": "node scripts/audit-freshness.mjs && node scripts/audit-verdict-tokens.mjs && node scripts/audit-pricing-drift.mjs",
    "gsc": "node scripts/gsc-report.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "isomorphic-dompurify": "^3.21.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "google-auth-library": "^10.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "sharp": ">=0.35.0"
  }
}
